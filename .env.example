# Database (Turso / libSQL). Leave unset locally to use data/portfolio.db.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Admin auth
ADMIN_PASSWORD=change-me
ADMIN_SESSION_SECRET=a-random-string-of-32-or-more-characters

# Cloudinary uploads (admin UPLOAD buttons). If the API key is unset the
# buttons are hidden and URLs can still be pasted.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dognbegiw
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
# Optional upload folder (defaults to "portfolio")
NEXT_PUBLIC_CLOUDINARY_UPLOAD_FOLDER=portfolio
